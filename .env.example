# Server
PORT=3000

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Prisma / Postgres (compose)
DATABASE_URL=
DIRECT_URL=

# Uploads (avatar storage)
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, files go to Supabase
# Storage. Otherwise they fall back to the local folder below (dev only).
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000

# Supabase Storage (recommended for avatars)
# Create a PUBLIC bucket (default name "avatars") in the Supabase dashboard.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

# Payments — Mercado Pago
# Sandbox/test access token (Painel > Suas integrações > Credenciais de teste).
MP_ACCESS_TOKEN=
# Webhook "Assinatura secreta" (Painel > Webhooks). When unset, signature
# validation is skipped (dev only).
MP_WEBHOOK_SECRET=
# Override only for testing against a mock server.
MP_BASE_URL=https://api.mercadopago.com

